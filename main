<div id="toolbar">
  <button onclick="exportJSON()">JSONエクスポート</button>
  
  <input type="file" id="import-file" accept=".json" style="display: none;" onchange="importJSON(event)">
  <button onclick="document.getElementById('import-file').click()">JSONインポート</button>
  
  <button class="btn-danger" onclick="clearData()">データをリセット</button>
</div>

<div id="mindmap-container">
  </div>

<script>
  const STORAGE_KEY = 'mindmap_app_data';

  // 1. ローカルストレージからのデータ読み込み
  let mindMapData = {
    id: 'root',
    text: 'メインテーマ',
    children: []
  };

  const savedData = localStorage.getItem(STORAGE_KEY);
  if (savedData) {
    try {
      mindMapData = JSON.parse(savedData);
    } catch (e) {
      console.error("データの読み込みに失敗しました", e);
    }
  }

  // 2. データをローカルストレージに保存する関数
  function saveData() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(mindMapData));
  }

  function generateId() {
    return '_' + Math.random().toString(36).substr(2, 9);
  }

  // ノードの生成処理
  function createNodeElement(nodeData, isRoot = false) {
    const wrapper = document.createElement('div');
    wrapper.className = isRoot ? 'is-root' : '';

    const nodeWrapper = document.createElement('div');
    nodeWrapper.className = 'node-wrapper';

    const nodeContent = document.createElement('div');
    nodeContent.className = 'node-content';

    const textDiv = document.createElement('div');
    textDiv.className = 'node-text';
    textDiv.contentEditable = true;
    textDiv.textContent = nodeData.text;
    
    // 文字入力のたびにデータを保存
    textDiv.addEventListener('input', (e) => {
      nodeData.text = e.target.textContent;
      saveData();
    });

    const controlsDiv = document.createElement('div');
    controlsDiv.className = 'controls';

    const addBtn = document.createElement('button');
    addBtn.className = 'node-btn';
    addBtn.textContent = '＋';
    addBtn.onclick = () => {
      nodeData.children.push({
        id: generateId(),
        text: '新しいノード',
        children: []
      });
      renderMindMap();
    };
    controlsDiv.appendChild(addBtn);

    if (!isRoot) {
      const delBtn = document.createElement('button');
      delBtn.className = 'node-btn node-btn-delete';
      delBtn.textContent = '×';
      delBtn.onclick = () => {
        deleteNode(mindMapData, nodeData.id);
        renderMindMap();
      };
      controlsDiv.appendChild(delBtn);
    }

    nodeContent.appendChild(textDiv);
    nodeContent.appendChild(controlsDiv);
    nodeWrapper.appendChild(nodeContent);
    wrapper.appendChild(nodeWrapper);

    if (nodeData.children && nodeData.children.length > 0) {
      const childrenContainer = document.createElement('div');
      childrenContainer.className = 'children-container';
      nodeData.children.forEach(child => {
        childrenContainer.appendChild(createNodeElement(child));
      });
      nodeWrapper.appendChild(childrenContainer);
    }

    return wrapper;
  }

  function deleteNode(parentNode, targetId) {
    if (parentNode.children) {
      const index = parentNode.children.findIndex(child => child.id === targetId);
      if (index !== -1) {
        parentNode.children.splice(index, 1);
        return true;
      }
      for (let child of parentNode.children) {
        if (deleteNode(child, targetId)) return true;
      }
    }
    return false;
  }

  // 描画処理（描画時に必ず保存処理も走らせる）
  function renderMindMap() {
    saveData();
    const container = document.getElementById('mindmap-container');
    container.innerHTML = '';
    container.appendChild(createNodeElement(mindMapData, true));
  }

  // 3. JSONエクスポート機能
  function exportJSON() {
    const dataStr = JSON.stringify(mindMapData, null, 2); // 見やすいようにインデントを付ける
    const blob = new Blob([dataStr], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    
    const a = document.createElement('a');
    a.href = url;
    a.download = 'mindmap_data.json';
    document.body.appendChild(a);
    a.click();
    
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // 4. JSONインポート機能
  function importJSON(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        const importedData = JSON.parse(e.target.result);
        if (importedData && importedData.id === 'root') {
          mindMapData = importedData;
          renderMindMap();
        } else {
          alert("マインドマップのデータ形式ではありません。");
        }
      } catch (err) {
        alert("無効なJSONファイルです。");
      }
    };
    reader.readAsText(file);
    event.target.value = ''; // 連続して同じファイルを読み込めるようにリセット
  }

  // 5. データのリセット（初期化）機能
  function clearData() {
    if (confirm("すべてのデータを消去して初期状態に戻しますか？（エクスポートしていないデータは失われます）")) {
      localStorage.removeItem(STORAGE_KEY);
      mindMapData = {
        id: 'root',
        text: 'メインテーマ',
        children: []
      };
      renderMindMap();
    }
  }

  // 初期描画
  renderMindMap();
</script>

</body>
</html>
