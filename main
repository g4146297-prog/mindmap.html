  .node-text {
    background: #ffffff;
    border: 2px solid #3498db;
    border-radius: 8px;
    padding: 10px 15px;
    min-width: 80px;
    text-align: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    outline: none;
    cursor: text;
    transition: all 0.2s;
    z-index: 2;
  }

  .node-text:focus {
    border-color: #2980b9;
    background: #ebf5fb;
  }

  /* 操作ボタン */
  .controls {
    display: flex;
    gap: 5px;
    margin-left: 10px;
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 2;
  }

  .node-content:hover .controls { opacity: 1; }

  .node-btn {
    background: #e0e0e0;
    border: none;
    border-radius: 4px;
